# Copy to .env.local (git-ignored) for local development:  cp .env.example .env.local
# Everything here is for the LOCAL docker stack only — no real AWS credentials belong in this file.

APP_ENV=local
AWS_REGION=ap-south-1

# Dummy keys shared by DynamoDB Local and MinIO (local containers only)
LOCAL_AWS_ACCESS_KEY_ID=minioadmin
LOCAL_AWS_SECRET_ACCESS_KEY=minioadmin
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000

MEDIA_BUCKET=gnj-local-media
IMPORTS_BUCKET=gnj-local-imports
MEDIA_BASE_URL=http://localhost:9000/gnj-local-media

# Email → Mailpit (UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=GiftNJoys <orders@giftnjoys.local>

PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:5173

# admin-api auth (local mode). Generate a secret with: openssl rand -hex 32
AUTH_MODE=local
LOCAL_JWT_SECRET=replace-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@giftnjoys.local
ADMIN_PASSWORD=replace-with-a-local-password

PUBLIC_API_PORT=4000
ADMIN_API_PORT=4001

# Frontends
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_ADMIN_API_URL=http://localhost:4001
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_MEDIA_BASE_URL=http://localhost:9000/gnj-local-media

# Store contact details applied by `pnpm seed` (also editable in Admin → Settings)
STORE_WHATSAPP_NUMBER=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
STORE_ADMIN_EMAILS=

# --- Optional: store images in AWS S3 + CloudFront while developing locally ---
# 1. terraform -chdir=infra/terraform/envs/dev output
# 2. pnpm --filter @gnj/scripts run sync-media -- --bucket <media_bucket_name>   (with AWS_PROFILE=giftnjoys-dev)
# 3. Comment out S3_ENDPOINT above and set:
# AWS_PROFILE=giftnjoys-dev
# MEDIA_BUCKET=<media_bucket_name>
# IMPORTS_BUCKET=<imports_bucket_name>
# MEDIA_BASE_URL=<cdn_url>
# VITE_MEDIA_BASE_URL=<cdn_url>
