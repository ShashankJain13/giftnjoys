# --- Secrets: never commit ---
*accessKeys*.csv
*credentials*.csv
*.pem
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example
kubeconfig*

# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfplan
.terraform.lock.hcl.bak

# --- Node / builds ---
node_modules/
dist/
.next/
.open-next/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts

# --- Test artifacts ---
e2e/test-results/
e2e/playwright-report/
e2e/.auth/

# --- Local data ---
samples/*
!samples/README.md
.local-data/

# --- OS / editors ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Terraform Lambda zips
infra/terraform/**/.build/
