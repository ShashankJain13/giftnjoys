{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".open-next/**"] },
    "typecheck": { "dependsOn": [] },
    "test": { "dependsOn": [], "outputs": [] }
  }
}
